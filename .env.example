# Polymarket Configuration
POLYMARKET_PRIVATE_KEY=your_polygon_wallet_private_key_here
POLYMARKET_FUNDER_ADDRESS=your_wallet_address_here
# Signature type: 0=EOA, 1=Magic/Email wallet, 2=Browser wallet
POLYMARKET_SIGNATURE_TYPE=0

# Binance API (public endpoints don't require keys, but rate limits are higher with keys)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Trading Configuration
# Maximum position size in USDC per trade
MAX_POSITION_SIZE=10.0
# Minimum edge (probability difference) to trigger a trade
MIN_EDGE=0.05
# How often to check for signals (seconds)
POLL_INTERVAL=60
# Dry run mode (no real trades)
DRY_RUN=true

# Logging
LOG_LEVEL=INFO
