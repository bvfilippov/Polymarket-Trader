# Polymarket Configuration
POLYMARKET_PRIVATE_KEY=your_polygon_wallet_private_key_here
POLYMARKET_FUNDER_ADDRESS=your_wallet_address_here
POLYMARKET_SIGNATURE_TYPE=0

# Binance (public endpoints, keys optional)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Trading
MAX_POSITION_SIZE=10.0
MIN_EDGE=0.02
DRY_RUN=true

# Spike Detection (core of lag-arb)
SPIKE_THRESHOLD_PCT=0.15
SPIKE_WINDOWS=10,30,60
VOLUME_SPIKE_MULTIPLIER=3.0

# Position Management / Auto-Exit
TAKE_PROFIT_RATIO=0.7
STOP_LOSS_BTC_REVERSAL=0.15
MAX_POSITION_AGE=300

# Limit Orders
USE_LIMIT_ORDERS=true
LIMIT_ORDER_OFFSET=0.005
LIMIT_ORDER_TIMEOUT=10

# Real-Time
SIGNAL_EVAL_INTERVAL=2.0
MARKET_REFRESH_INTERVAL=30
TRADE_COOLDOWN=15
ORDERBOOK_DEPTH=20
LARGE_TRADE_THRESHOLD=50000
CVD_WINDOW=500

# Logging
LOG_LEVEL=INFO
